PORT=3000
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200
JWT_SECRET=change-me
# Session cookie (httpOnly). Local SPA on :4200 talking to :3000 is same-site → Lax.
# Production frontend and API on different hosts: COOKIE_SECURE=true and COOKIE_SAMESITE=none
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Optional. Without these, in-app notifications still work and mail is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UHKS nominacije <noreply@example.com>"
# Mailtrap sandbox only (~1 mail/s). Production (Resend/Postmark): omit or 0.
SMTP_MIN_INTERVAL_MS=1100
