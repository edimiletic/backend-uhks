PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/uhks
CORS_ORIGIN=http://localhost:4200,http://localhost:8080
FRONTEND_URL=http://localhost:4200
JWT_SECRET=change-me
# Production (Railway) refuses to start if JWT_SECRET is still change-me,
# CORS_ORIGIN/FRONTEND_URL are localhost, COOKIE_SECURE=false, or SMTP_MIN_INTERVAL_MS>0.
# Railway/nginx: 1 hop. Local npm run dev: leave unset. TRUST_PROXY=0 disables it.
# TRUST_PROXY=1
# Session cookie (httpOnly). Local SPA on :4200 talking to :3000 is same-site → Lax.
# Production frontend and API on different hosts: COOKIE_SECURE=true and COOKIE_SAMESITE=none
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Optional. Without these, in-app notifications still work and mail is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UHKS nominacije <noreply@example.com>"
# Mailtrap sandbox only (~1 mail/s). Production (Resend/Postmark): omit or 0.
SMTP_MIN_INTERVAL_MS=1100
